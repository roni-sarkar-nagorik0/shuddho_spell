{
  "name": "shuddhospell",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "setup:check": "node scripts/check-setup.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/migrate.mjs",
    "db:migrate:dry": "node scripts/migrate.mjs --dry-run",
    "content:validate": "tsx scripts/content-validate.ts",
    "prebuild": "pnpm content:validate",
    "content:seed": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx scripts/content-seed.ts",
    "content:seed:dry": "tsx scripts/content-seed.ts --dry-run",
    "content:author": "tsx scripts/author-week.ts",
    "content:report": "tsx scripts/content-report.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.58.0",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "2.1.1",
    "next": "15.5.4",
    "next-intl": "4.3.5",
    "pino": "9.5.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.3.1",
    "web-push": "^3.6.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@electric-sql/pglite": "^0.5.5",
    "@eslint/js": "9.37.0",
    "@playwright/test": "1.56.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.10.2",
    "@types/pg": "8.15.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "10.4.21",
    "eslint": "9.37.0",
    "eslint-config-next": "15.5.4",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-boundaries": "5.0.1",
    "eslint-plugin-import": "2.32.0",
    "jsdom": "26.1.0",
    "pg": "8.16.3",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.18",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.45.0",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
