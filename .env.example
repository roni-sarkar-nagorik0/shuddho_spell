# ============================================================================
# ShuddhoSpell — environment variables
#
# Copy to .env.local and fill in.  NEVER commit .env.local.
#
#   cp .env.example .env.local
#
# Every variable here is validated by Zod at boot (src/lib/env.ts).
# A missing or malformed value stops the app from starting and prints
# exactly which variable is wrong — that is deliberate.
#
# NEXT_PUBLIC_* is shipped to the browser. Everything else is server-only
# and must never be imported into a Client Component.
# ============================================================================


# ----------------------------------------------------------------------------
# 1. CORE  (required — the app will not boot without these)
# ----------------------------------------------------------------------------

# Which environment this is. "development" locally, "production" when deployed.
NODE_ENV=development

# The app's own public URL. Used for OAuth redirects, push payload links,
# email links and certificate verification URLs. No trailing slash.
# Local: http://localhost:3000    Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ----------------------------------------------------------------------------
# 2. SUPABASE  (required)
#
# Where to find these:
#   supabase.com → your project → Project Settings → API
# There is NO local database and NO Docker — development runs against a hosted
# Supabase project. Use a SEPARATE project for development, never production.
# ----------------------------------------------------------------------------

# Project URL.  Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Anon / publishable key. Safe in the browser — it is gated by Row Level
# Security, which is why RLS is written as if the API did not exist.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key. FULL DATABASE ACCESS — bypasses every RLS policy.
# Server-only. Never import this into a Client Component, never log it,
# never expose it through an API response. Used only by:
#   - repository implementations in src/modules/*/infrastructure
#   - the content seed CLI
#   - cron route handlers
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Postgres connection string. Used ONLY by the migration runner (pnpm db:migrate)
# and the content seed CLI — never by the running app.
#
# Project Settings → Database → Connection string. Take the SESSION POOLER URI,
# not the direct one: Supabase serves db.<ref>.supabase.co over IPv6 only, and
# most home and office networks are IPv4-only, so the direct URI fails with
# ENOTFOUND. The pooler host is IPv4 and works everywhere.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres


# ----------------------------------------------------------------------------
# 3. GOOGLE OAUTH  (required — Google is the ONLY sign-in method)
#
# These are configured in the SUPABASE DASHBOARD, not read by this app:
#   Supabase → Authentication → Providers → Google → enable, paste both values
#
# To get them:
#   1. console.cloud.google.com → APIs & Services → Credentials
#   2. Create OAuth client ID → Web application
#   3. Authorised redirect URI:  https://<your-project>.supabase.co/auth/v1/callback
#
# Configured in the Supabase dashboard (Authentication → Providers → Google),
# not read by this app. Kept here only so the values live in one place.
# ----------------------------------------------------------------------------

GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# Where Supabase sends the user back after Google. Must match the route
# handler at src/app/auth/callback/route.ts.
NEXT_PUBLIC_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback


# ----------------------------------------------------------------------------
# 4. WEB PUSH / VAPID  (required from Phase 8 — notifications)
#
# Generate a key pair once:
#   npx web-push generate-vapid-keys
#
# Keep the pair stable. Regenerating invalidates every existing browser
# subscription and silently kills push for every learner.
# ----------------------------------------------------------------------------

# Public key — safe in the browser, the service worker needs it.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BEl6...

# Private key — server-only. Never expose.
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxx

# Contact for push services, as a mailto: or https: URL. This is a contact
# address for the push provider, not a sending address — no email is sent.
VAPID_SUBJECT=mailto:support@your-domain.com


# ----------------------------------------------------------------------------
# 5. EMAIL  (NOT USED — deferred to v2)
#
# The app sends NO email. Notifications ship on two channels only: in-app and
# web push. Nothing in the build reads these variables, and the boot schema
# does not require them — leave them commented out.
#
# When email is picked up in v2: uncomment, implement the IMailer port and its
# adapter, and enable the email channel in NotificationPolicy. The
# `email` value already exists in the NotificationChannel union and in the
# database check constraint, so no migration is needed then.
#
# Get a key: resend.com → API Keys. The from-address domain must be verified.
# ----------------------------------------------------------------------------

# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# EMAIL_FROM="ShuddhoSpell <noreply@your-domain.com>"


# ----------------------------------------------------------------------------
# 6. CRON  (required from Phase 7)
#
# Scheduled work runs as protected route handlers under /api/cron/*, called by
# Vercel Cron (or any scheduler). Jobs: exam auto-submit for abandoned
# attempts, hourly notification dispatch, weekly reports.
#
# Every /api/cron/* handler rejects a request whose Authorization header is not
# `Bearer ${CRON_SECRET}`. Without this, anyone can trigger your jobs.
#
# Generate: openssl rand -base64 32
# ----------------------------------------------------------------------------

CRON_SECRET=


# ----------------------------------------------------------------------------
# 7. RATE LIMITING  (optional)
#
# Default limiter is Postgres-backed and needs no configuration — it works out
# of the box. Set these only to swap in Upstash Redis behind the same
# IRateLimiter port (worth it on serverless at scale).
#
# upstash.com → Redis → REST API
# ----------------------------------------------------------------------------

# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx


# ----------------------------------------------------------------------------
# 8. OBSERVABILITY  (optional locally, required in production)
#
# sentry.io → your project → Settings → Client Keys (DSN)
# ----------------------------------------------------------------------------

# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx
# SENTRY_AUTH_TOKEN=sntrys_xxxx        # source map upload at build time only
# SENTRY_ORG=your-org
# SENTRY_PROJECT=shuddhospell

# Log level: trace | debug | info | warn | error
LOG_LEVEL=debug


# ----------------------------------------------------------------------------
# 9. FEATURE FLAGS  (optional)
# ----------------------------------------------------------------------------

# Let learners opt into storing their pronunciation audio. Default false —
# with this off, audio never leaves the browser and the server only ever sees
# the transcript. Leave it off unless you have a retention policy written down.
NEXT_PUBLIC_ENABLE_AUDIO_STORAGE=false

# Seed the database with course content on `pnpm db:reset`. Local only.
SEED_CONTENT_ON_RESET=true


# ============================================================================
# WHAT YOU ACTUALLY NEED, BY PHASE
#
#   Phase 1  NODE_ENV, NEXT_PUBLIC_APP_URL, the three Supabase vars, DATABASE_URL
#   Phase 2  the same — plus a running local Supabase
#   Phase 3  + Google OAuth configured in the Supabase dashboard
#   Phase 7  + CRON_SECRET
#   Phase 8  + VAPID pair  (email is NOT used — deferred to v2)
#   Phase 13 + Sentry, and Upstash if you want it
#
# Minimum to run `pnpm dev` today: section 1 and section 2.
# ============================================================================
